# Copy to .env and fill in the key. Any OpenAI-compatible endpoint works; swap models by editing these lines only.

# Groq free tier (key from https://console.groq.com). Tested 7-8 Nov 2026: 8,000 tokens a minute and
# 1,000 requests a day per model.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
# Stronger model for the name map, the judge and the ranking; empty = reuse LLM_MODEL
JUDGE_MODEL=openai/gpt-oss-120b
# gpt-oss accepts low / medium / high; low keeps hidden reasoning tokens small
LLM_REASONING_EFFORT=low

# Override any single stage with its own provider, key or model:
# SCORE_BASE_URL= / SCORE_API_KEY= / SCORE_MODEL=      pass 1
# JUDGE_BASE_URL= / JUDGE_API_KEY= / JUDGE_MODEL=      name map and judge
# RANK_BASE_URL=  / RANK_API_KEY=  / RANK_MODEL=       pairwise ranking (falls back to JUDGE_*)
# <STAGE>_REASONING_EFFORT=     leave unset for providers that do not support it
# <STAGE>_TEMPERATURE=none      send no temperature (newer Gemini and OpenAI reasoning models); default 0.2
# <STAGE>_RPM=5                 cap requests per minute, for providers that send no rate-limit headers

# Google Gemini (free key from https://aistudio.google.com/apikey; new keys start with "AQ." and work here).
# Tested 7-8 Nov 2026 as a second judge. Free-tier limits are per project and shown only in AI Studio.
# JUDGE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# JUDGE_API_KEY=
# JUDGE_MODEL=gemini-3.8-flash
# JUDGE_REASONING_EFFORT=low     (3.8 Flash rejects "minimal")
# JUDGE_TEMPERATURE=none         (Gemini 3.6 and later ignore it)
# JUDGE_RPM=5

# OpenAI (reasoning models: the client switches to max_completion_tokens and drops temperature by itself)
# LLM_BASE_URL=https://api.openai.com/v1

# OpenRouter
# LLM_BASE_URL=https://openrouter.ai/api/v1

# Local Ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
